#version 330 core

in vec3 fragNormal_cameraspace;
in vec3 eyeDirection_cameraspace;
in vec3 lightDirection1_cameraspace;
in vec3 lightDirection2_cameraspace;

uniform vec3 lightColor1;
uniform vec3 lightColor2;
uniform vec3 materialAmbient;
uniform vec3 materialDiffuse;
uniform vec3 materialSpecular;
uniform float materialShininess;

out vec3 color;

vec3 phongContribution(vec3 lightDir, vec3 lightColor, vec3 N, vec3 E) {
    float cosTheta = max(dot(N, lightDir), 0.0);
    vec3 diffuse = materialDiffuse * lightColor * cosTheta;

    vec3 R = reflect(-lightDir, N);
    float cosAlpha = max(dot(E, R), 0.0);
    vec3 specular = materialSpecular * lightColor * pow(cosAlpha, materialShininess);

    return diffuse + specular;
}

void main() {
    vec3 N = normalize(fragNormal_cameraspace);
    vec3 E = normalize(eyeDirection_cameraspace);

    vec3 ambient = materialAmbient * (lightColor1 + lightColor2) * 0.5;

    vec3 lighting = ambient;
    lighting += phongContribution(lightDirection1_cameraspace, lightColor1, N, E);
    lighting += phongContribution(lightDirection2_cameraspace, lightColor2, N, E);

    color = clamp(lighting, 0.0, 1.0);
}